---
import "../styles/global.css";

const pageTitle = "Miller Emion - Junior Software Engineer";
const description =
  "Miller Emion is a junior software engineer building practical software, AI tools, developer systems, and open-source projects.";

const navLinks = [
  { label: "Work", href: "#work" },
  { label: "Notes", href: "#notes" },
  { label: "Contact", href: "#contact" }
];

const workItems = [
  {
    number: "01",
    title: "Agent Notes",
    focus:
      "Open-source local notes and durable context for coding agents.",
    tags: ["Astro", "TypeScript", "Local-first", "Agents"],
    status: "Exploring",
    statusTone: "green"
  },
  {
    number: "02",
    title: "Homelab / Infrastructure",
    focus:
      "Remote access, local services, backups, and small reliable systems.",
    tags: ["Linux", "Networking", "Backups", "Remote access"],
    status: "Learning",
    statusTone: "amber"
  },
  {
    number: "03",
    title: "AI Tooling Experiments",
    focus:
      "Local AI workflows, automation tests, and agent-oriented tooling.",
    tags: ["OpenAI", "Local AI", "Automation", "CLI"],
    status: "Building",
    statusTone: "green"
  }
];

const notes = [
  "Practicing fundamentals through review and repetition.",
  "Keeping scope small enough to finish and improve.",
  "Studying where AI-assisted engineering helps and where it gets messy."
];

const contactLinks = [
  { label: "GitHub", href: "https://github.com/XtraSaltyDev" },
  { label: "Email", href: "mailto:hello@memion.io" },
  { label: "Resume", href: "/resume.pdf" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://memion.io" />
    <meta property="og:site_name" content="memion.io" />
    <meta name="theme-color" content="#fbfcfb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="brand-lockup" href="/" aria-label="memion.io home">
          <span class="brand-mark" aria-hidden="true">ME</span>
          <span>memion.io</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          {
            navLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="site-shell hero" aria-labelledby="hero-title">
        <p class="eyebrow">Portfolio / 2026</p>
        <h1 id="hero-title">Miller Emion</h1>
        <p class="role">Junior Software Engineer</p>
        <p class="statement">
          Building practical software, AI tools, and developer systems.
        </p>
      </section>

      <section id="work" class="site-shell section work-section" aria-labelledby="work-title">
        <div class="section-heading">
          <h2 id="work-title" class="section-label">Work</h2>
        </div>

        <div class="work-table" aria-label="Selected work">
          <div class="work-row work-head" aria-hidden="true">
            <span>#</span>
            <span>Project</span>
            <span>Focus</span>
            <span>Status</span>
            <span>Tags</span>
          </div>

          {
            workItems.map((item) => (
              <article class="work-row">
                <p class="work-number">{item.number}</p>
                <h3>{item.title}</h3>
                <p class="work-focus">{item.focus}</p>
                <p class="work-status">
                  <span class:list={["status-dot", item.statusTone]} aria-hidden="true"></span>
                  {item.status}
                </p>
                <ul class="tag-list" aria-label={`${item.title} focus tags`}>
                  {item.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="notes" class="site-shell section notes-section" aria-labelledby="notes-title">
        <div class="section-heading">
          <h2 id="notes-title" class="section-label">Notes</h2>
        </div>

        <div class="notes-grid">
          <div class="note-copy">
            <p>
              I am an early-career software engineer focused on useful,
              practical software. I learn fastest by building real things,
              testing them honestly, and improving the pieces that make everyday
              development smoother.
            </p>
          </div>
          <ul class="note-list">
            {notes.map((note) => <li>{note}</li>)}
          </ul>
        </div>
      </section>

      <section id="contact" class="site-shell section contact-section" aria-labelledby="contact-title">
        <div>
          <h2 id="contact-title" class="section-label">Contact</h2>
          <p>Open to junior engineering roles and thoughtful collaboration.</p>
        </div>

        <div class="contact-links" aria-label="Contact links">
          {
            contactLinks.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="site-shell site-footer">
      <p>&copy; {new Date().getFullYear()} Miller Emion</p>
      <p>Built with Astro. Hosted on Vercel.</p>
    </footer>
  </body>
</html>
